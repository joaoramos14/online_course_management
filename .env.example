SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-secret-key
PORT=3000

# Direct connection to Postgres, used only by migrations and seeders.
# Supabase > Connect > Session pooler (replace [YOUR-PASSWORD] with the database password)
DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

{
    "info": {
        "name": "Online Course Management - Modules and Contents",
        "description": "Run the folders in order. The requests create a module and a content, test them and delete them at the end.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Modules",
            "item": [
                {
                    "name": "Create module",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/modules",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "modules"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"course_id\": \"{{courseId}}\",\n    \"user_id\": \"{{userId}}\",\n    \"title\": \"Postman module\",\n    \"description\": \"Created by the Postman collection\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test(\"Status 201\", function () {",
                                    "    pm.response.to.have.status(201);",
                                    "});",
                                    "const module = pm.response.json();",
                                    "pm.collectionVariables.set(\"moduleId\", module.id);",
                                    "",
                                    "pm.test(\"Module goes to the end of the course\", function () {",
                                    "    pm.expect(module.position).to.be.above(0);",
                                    "    pm.expect(module.title).to.eql(\"Postman module\");",
                                    "});"
                                ]
                            }
                        }
                    ]
                },
